# Files and folders that should not end up in the plugin published on
# WordPress.org. The uncompiled sources in /src are shipped alongside /build,
# so the minified assets always have readable sources next to them.
/.distignore
/.editorconfig
/.git
/.github
/.gitattributes
/.gitignore
/.idea
/.nvmrc
/.wordpress-org
/composer.json
/composer.lock
/node_modules
/package.json
/package-lock.json
/phpcs.xml.dist
/phpstan.neon
/bin
