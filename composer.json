{
	"name": "acato/disable-meta-box-resizing",
	"description": "Lets each user turn off the resizable meta box panel that WordPress 7.0 added to the bottom of the post editor.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/acato-plugins/disable-meta-box-resizing",
	"authors": [
		{
			"name": "Acato",
			"homepage": "https://acato.nl"
		},
		{
			"name": "Paul van Impelen",
			"homepage": "https://profiles.wordpress.org/paulacato/"
		}
	],
	"require": {
		"php": ">=8.2",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
